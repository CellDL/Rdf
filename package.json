{
    "name": "@celldl/rdf",
    "version": "1.20260814.0",
    "author": {
        "name": "David Brooks",
        "email": "d.brooks@auckland.ac.nz"
    },
    "bugs": {
        "url": "https://github.com/CellDL/Rdf/issues"
    },
    "description": "An Oxigraph based RDF store.",
    "files": [
        "dist",
        "README.md",
        "LICENSE.txt"
    ],
    "keywords": [
        "celldl",
        "bg-rdf"
    ],
    "license": "Apache-2.0",
    "module": "dist/Rdf.es.js",
    "productName": "Rdf",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CellDL/Rdf.git"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/Rdf.es.js"
        }
    },
    "scripts": {
        "build": "bun oxigraph:check && vite build --config vite.config.ts",
        "clean": "bun scripts/clean.js",
        "format": "bunx --bun biome format --fix --max-diagnostics=none",
        "format:check": "bunx --bun biome format --max-diagnostics=none",
        "lint": "bunx --bun biome lint --fix --error-on-warnings --max-diagnostics=none",
        "oxigraph:check": "bun ./scripts/check-oxigraph.ts",
        "version:new": "bun scripts/version.js"
    },
    "dependencies": {
        "@jeswr/pretty-turtle": "^1.8.2",
        "oxigraph": "^0.5.9"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@types/node": "^25.0.9",
        "typescript": "^7.0.2",
        "vite": "^8.2.0"
    }
}
